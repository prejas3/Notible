{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notible",
  "mainBinaryName": "NotibleApp",
  "version": "0.97.0",
  "identifier": "com.notible.app",
  "build": {
    "beforeBuildCommand": "npm run build:test-host",
    "frontendDist": "../dist-test-host"
  },
  "app": {
    "windows": [
      {
        "title": "Notible",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' plugin: http://plugin.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQzFEQkFCRTEzM0ZGRDAKUldUUS96UGhxOXZCN1NPQXcvNzRlZUhxZ3B3K2VheDlKRzRVU3AvUFpaUWw4dUZRcDlrOVpNVGEK",
      "endpoints": [
        "https://updates.szymonjankiewicz.com/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "../mcp-server/index.js": "mcp-server/index.js",
      "../mcp-server/lib.js": "mcp-server/lib.js",
      "../mcp-server/package.json": "mcp-server/package.json",
      "../mcp-server/node_modules": "mcp-server/node_modules",
      "../mcp-server/runtime/node.exe": "mcp-server/runtime/node.exe"
    },
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
